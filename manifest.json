{
  "manifest_version": 3,
  "name": "AmoTube (AMOLED YouTube)",
  "short_name": "AmoTube",
  "version": "2.2.0",
  "author": "lucmsilva651@gmail.com",
  "incognito": "split",
  "homepage_url": "https://github.com/lucmsilva651/AmoTube",
  "description": "A browser extension that makes YouTube AMOLED and adds some more features. Good for your eyes, good for your screen.",
  "update_url": "https://raw.githubusercontent.com/lucmsilva651/amotube/main/updates.xml",
  "key": "",
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png",
    "500": "assets/icon500.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/GoogleSansFlex-VariableFont_ROND,opsz,slnt,wdth,wght.ttf"],
      "matches": ["*://*.youtube.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "css": ["src/inject.css"],
      "run_at": "document_end"
    }
  ]
}
